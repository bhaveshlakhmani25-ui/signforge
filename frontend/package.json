{
  "name": "signforge-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup:models": "mkdir -p public/models && cp node_modules/@mediapipe/tasks-vision/wasm/* public/models/ && curl -fsSL -o public/models/holistic_landmarker.task https://storage.googleapis.com/mediapipe-models/holistic_landmarker/holistic_landmarker/float16/latest/holistic_landmarker.task",
    "typecheck": "tsc --noEmit",
    "test:gestures": "node --experimental-strip-types --no-warnings lib/__tests__/gestures.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
